#!/usr/bin/perl

use strict;
use warnings;

use lib qw(./lib);
use Enic::Terminal;

use Gtk3 -init;

my $window;
my $main_container;
my $pane_count = 0;
my %widget_map;  # Mapeia widget -> {parent, position}

sub main {
    $window = Gtk3::Window->new('toplevel');
    $window->set_title('Enic - Terminal Emulator');
    $window->set_default_size(800, 600);
    $window->signal_connect('destroy', sub { Gtk3::main_quit() });

    $main_container = Gtk3::Box->new('vertical', 0);
    $window->add($main_container);

    # Cria o primeiro terminal
    my $primeiro = Enic::Terminal->new();
    setup_terminal($primeiro);
    $pane_count = 1;

    $widget_map{$primeiro->widget()} = { parent => undef, position => 0 };
    $main_container->pack_start($primeiro->widget(), 1, 1, 0);
    $window->show_all();
    $primeiro->iniciar_bash();

    Gtk3::main();
}

sub setup_terminal {
    my ($terminal) = @_;
    
    $terminal->widget()->signal_connect('child-exited', sub {
        $pane_count--;
        if ($pane_count <= 0) {
            Gtk3::main_quit();
        }
    });

    $terminal->widget()->signal_connect('button-press-event', sub {
        my ($widget, $event) = @_;
        if ($event->button == 3) {
            show_menu($widget, $event, $terminal);
            return 1;
        }
        return 0;
    });
}

sub show_menu {
    my ($widget, $event, $terminal) = @_;

    my $menu = Gtk3::Menu->new();

    my $copy = Gtk3::MenuItem->new_with_label('Copiar');
    $copy->signal_connect('activate', sub { $widget->copy_clipboard() });
    $menu->append($copy);

    my $paste = Gtk3::MenuItem->new_with_label('Colar');
    $paste->signal_connect('activate', sub { $widget->paste_clipboard() });
    $menu->append($paste);

    $menu->append(Gtk3::SeparatorMenuItem->new());

    my $select = Gtk3::MenuItem->new_with_label('Selecionar tudo');
    $select->signal_connect('activate', sub { $widget->select_all() });
    $menu->append($select);

    my $clear = Gtk3::MenuItem->new_with_label('Limpar');
    $clear->signal_connect('activate', sub { $widget->reset(1, 1) });
    $menu->append($clear);

    $menu->append(Gtk3::SeparatorMenuItem->new());

    unless ($pane_count >= 4) {
        my $split_v = Gtk3::MenuItem->new_with_label('Split vertical');
        $split_v->signal_connect('activate', sub {
            split_pane($terminal, 'vertical');
        });
        $menu->append($split_v);

        my $split_h = Gtk3::MenuItem->new_with_label('Split horizontal');
        $split_h->signal_connect('activate', sub {
            split_pane($terminal, 'horizontal');
        });
        $menu->append($split_h);
    }

    $menu->show_all();
    $menu->popup_at_pointer($event);
}

sub split_pane {
    my ($current_terminal, $orientation) = @_;

    if ($pane_count >= 4) {
        warn "Máximo de 4 terminais!\n";
        return;
    }

    my $novo = Enic::Terminal->new();
    setup_terminal($novo);
    $pane_count++;

    my $widget_atual = $current_terminal->widget();
    my $widget_novo = $novo->widget();

    my $paned = $orientation eq 'vertical'
        ? Gtk3::Paned->new('vertical')
        : Gtk3::Paned->new('horizontal');

    my $parent_info = $widget_map{$widget_atual};
    my $parent = $parent_info->{parent};
    my $position = $parent_info->{position};

    # IMPORTANTE: Remove do container antigo PRIMEIRO
    if (!$parent) {
        $main_container->remove($widget_atual);
    } else {
        # Remove do paned pai
        my $old_parent = $widget_atual->get_parent();
        if ($old_parent) {
            $old_parent->remove($widget_atual);
        }
    }

    # AGORA adiciona ao novo paned (sem conflito de pai)
    $paned->pack1($widget_atual, 1, 1);
    $paned->pack2($widget_novo, 1, 1);

    # Adiciona o paned ao seu container pai
    if (!$parent) {
        $main_container->pack_start($paned, 1, 1, 0);
    } else {
        if ($position == 1) {
            $parent->pack1($paned, 1, 1);
        } else {
            $parent->pack2($paned, 1, 1);
        }
    }

    # Atualiza o mapa
    $widget_map{$paned} = { parent => $parent, position => $position };
    $widget_map{$widget_atual} = { parent => $paned, position => 1 };
    $widget_map{$widget_novo} = { parent => $paned, position => 2 };

    $window->show_all();
    $novo->iniciar_bash();
}


main();

